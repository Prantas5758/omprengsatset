        { week: 4, tasks: [{ name: 'Fajar R', task: 'Westafel', type: 'westafel' }, { name: 'Zaidan', task: 'Gestrep', type: 'gestrep' }, { name: 'Aziz', task: 'Selokan', type: 'selokan' }, { name: 'Agus', task: 'Ompreng & Pengering', type: 'ompreng' }, { name: 'Zakaria', task: 'Ompreng & Pengering', type: 'ompreng' }, { name: 'Fajar M', task: 'Sikat lantai', type: 'lantai' }, { name: 'Rizal', task: 'Sikat lantai', type: 'lantai' }, { name: 'Adit', task: 'Sikat lantai', type: 'lantai' }] },
