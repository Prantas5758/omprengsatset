    ];

    // =====================================================
    // LOGIKA PERHITUNGAN MINGGU & HARI
    // =====================================================
    function mod(n, m) { return ((n % m) + m) % m; }

    function getActiveWeeks() {
        const startDate = new Date(CYCLE_START_DATE);
        const now = new Date();
        
        // Perbaikan: Gunakan UTC untuk mencegah error pergeseran zona waktu tengah malam
        const utcStart = Date.UTC(startDate.getFullYear(), startDate.getMonth(), startDate.getDate());
        const utcNow = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
        
        const diffDays = Math.floor((utcNow - utcStart) / 86400000);
        
        const autoDaily = Math.floor(mod(diffDays, 14) / 7) + 1;
        const autoFriday = Math.floor(mod(diffDays, 56) / 7) + 1;

        const urlParams = new URLSearchParams(window.location.search);
        const paramDaily = parseInt(urlParams.get('daily'));
        const paramFriday = parseInt(urlParams.get('friday'));

        const finalDaily = (!isNaN(paramDaily) && paramDaily >= 1 && paramDaily <= 2) ? paramDaily : autoDaily;
        const finalFriday = (!isNaN(paramFriday) && paramFriday >= 1 && paramFriday <= 8) ? paramFriday : autoFriday;

        return { daily: finalDaily, friday: finalFriday, diffDays };
    }

    // =====================================================
    // RENDER FUNCTIONS
    // =====================================================
    function getBadgeClass(type) {
        const map = { gestrep: 'badge-gestrep', westafel: 'badge-westafel', ompreng: 'badge-ompreng', lantai: 'badge-lantai', selokan: 'badge-selokan', tutup: 'badge-tutup' };
        return `badge-base ${map[type] || 'bg-slate-200 text-slate-700'}`;
    }

    function renderMembers() {
        const el = document.getElementById('memberList');
        el.innerHTML = MEMBERS.map(m =>
            `<button type="button" id="btn-member-${m}" onclick="toggleMemberFilter('${m}')" class="member-btn bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 hover:border-indigo-200 dark:hover:border-indigo-700 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors cursor-pointer px-3 py-1.5 rounded-lg text-sm font-semibold text-slate-700 dark:text-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500">${m}</button>`
        ).join('');
    }

    function renderOmpreng() {
        const el = document.getElementById('omprengSchedule');
        const days = ['Senin', 'Selasa', 'Rabu', 'Kamis'];
        let html = days.map(d =>
            `<div class="flex justify-between items-center pb-3 border-b border-slate-100 dark:border-slate-700">
                <span class="font-semibold text-slate-900 dark:text-white">${d}</span>
                <span class="text-sm text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-slate-700 px-2 py-0.5 rounded border border-slate-200 dark:border-slate-600">${OMPRENG_SCHEDULE[d]}</span>
            </div>`
        ).join('');
        html += `<div class="bg-indigo-50/50 dark:bg-indigo-900/20 p-3 rounded-xl border border-indigo-100 dark:border-indigo-800">
            <span class="block font-semibold text-indigo-700 dark:text-indigo-300 mb-1">Jum'at</span>
            <span class="block text-sm text-indigo-900/70 dark:text-indigo-300/70">• Zaidan (rotasi)</span>
        </div>`;
        el.innerHTML = html;
    }

    function renderFridayRotation() {
        const el = document.getElementById('fridayRotation');
        el.innerHTML = FRIDAY_ROTATION.map((name, i) =>
            `<div class="flex justify-between border-b border-slate-700/50 pb-1"><span class="text-slate-500 font-mono text-xs">M${i+1}</span> <span class="font-medium text-white">${name}</span></div>`
        ).join('');
    }

    function renderBilas() {
        const el = document.getElementById('bilasSchedule');
        el.innerHTML = BILAS_SCHEDULE.map(w => {
            const rows = w.days.map(d =>
                `<div class="grid grid-cols-12 gap-2 ${d.day !== 'KAM' ? 'border-b border-slate-100 dark:border-slate-700 pb-1.5' : ''} items-center">
                    <span class="col-span-2 font-bold text-slate-500 dark:text-slate-400">${d.day}</span>
                    <div class="col-span-5 flex flex-col font-medium dark:text-slate-200" data-member="${d.p1.name}">
                        <span>${d.p1.name}</span><span class="text-[11px] text-slate-500 dark:text-slate-400 font-normal">${d.p1.task}</span>
                    </div>
                    <div class="col-span-5 flex flex-col font-medium dark:text-slate-200" data-member="${d.p2.name}">
                        <span>${d.p2.name}</span><span class="text-[11px] text-slate-500 dark:text-slate-400 font-normal">${d.p2.task}</span>
                    </div>
                </div>`
            ).join('');
            return `<div class="border border-slate-200 dark:border-slate-600 rounded-2xl overflow-hidden">
                <div class="bg-slate-50 dark:bg-slate-700 text-xs font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 p-2.5 text-center border-b border-slate-200 dark:border-slate-600">Minggu ${w.week}</div>
                <div class="p-3 text-xs space-y-2">${rows}</div>
            </div>`;
        }).join('');
    }

    function renderBilasFriday() {
        const el = document.getElementById('bilasFridaySchedule');
        if (!el) return;
        const { friday: activeFriday } = getActiveWeeks();
        const finalFriday = MANUAL_FRIDAY_WEEK ?? activeFriday;

        el.innerHTML = BILAS_FRIDAY_SCHEDULE.map(w => {
            const isActive = w.week === finalFriday;
            const badgeClass = (task) => task === 'Ompreng' ? 'badge-ompreng' : 'badge-tutup';
            return `<div class="flex items-center gap-2 p-2.5 rounded-xl border transition-all duration-300 ${
                isActive
                    ? 'bg-violet-50 dark:bg-violet-900/20 border-violet-300 dark:border-violet-700 shadow-sm'
                    : 'border-slate-100 dark:border-slate-700'
            }">
                <span class="font-mono text-[11px] font-bold w-8 shrink-0 ${
                    isActive ? 'text-violet-600 dark:text-violet-300' : 'text-slate-400 dark:text-slate-500'
                }">M${w.week}</span>
                <div class="flex-1 flex items-center gap-1.5 text-xs" data-member="${w.p1.name}">
                    <span class="font-semibold text-slate-800 dark:text-slate-200">${w.p1.name}</span>
                    <span class="badge-base ${badgeClass(w.p1.task)} text-[9px] py-0.5 px-1.5">${w.p1.task}</span>
                </div>
                <div class="flex-1 flex items-center gap-1.5 text-xs" data-member="${w.p2.name}">
                    <span class="font-semibold text-slate-800 dark:text-slate-200">${w.p2.name}</span>
                    <span class="badge-base ${badgeClass(w.p2.task)} text-[9px] py-0.5 px-1.5">${w.p2.task}</span>
                </div>
            </div>`;
        }).join('');
    }

    function renderDailySchedule() {
        const el = document.getElementById('dailyGrid');
        
        const { diffDays } = getActiveWeeks();
        const actualDailyDayIndex = mod(diffDays, 14);
        const dayOffset = { 'Senin': 0, 'Selasa': 1, 'Rabu': 2, 'Kamis': 3, 'Jumat': 4, 'Sabtu': 5, 'Minggu': 6 };

        el.innerHTML = DAILY_SCHEDULE.map(w => {
            const daysHtml = w.days.map(d => {
                const blockAbsoluteIndex = ((w.week - 1) * 7) + dayOffset[d.day];
                const isTrulyToday = (blockAbsoluteIndex === actualDailyDayIndex);

                const tasksHtml = d.tasks.map(t => {
                    // Perbaikan: Semua tugas menggunakan desain badge seragam
                    const badge = `<span class="${getBadgeClass(t.type)} whitespace-normal text-right ml-2">${t.task}</span>`;
                        
                    return `<div class="flex justify-between items-start transition-all duration-300 py-1" data-member="${t.name}">
                                <span class="font-semibold text-slate-900 dark:text-white shrink-0 text-base mt-0.5">${t.name}</span>
                                ${badge}
                            </div>`;
                }).join('');
                
                return `<div id="day-block-${blockAbsoluteIndex}" class="grid grid-cols-[80px_1fr] gap-4 items-start ${d.day !== 'Kamis' ? 'border-b border-slate-100 dark:border-slate-700 pb-4' : ''} ${isTrulyToday ? 'today-highlight ring-2 ring-indigo-400 ring-offset-2 dark:ring-offset-slate-800 rounded-xl p-3 -mx-3 relative z-10' : ''}">
                    <div class="font-bold text-slate-700 dark:text-slate-300 bg-slate-100/80 dark:bg-slate-700/80 px-2 py-1.5 rounded-lg text-center text-sm border border-slate-200 dark:border-slate-600 uppercase tracking-wide sticky top-16">${d.day}</div>
                    <div class="text-sm text-slate-600 dark:text-slate-300 space-y-1.5 leading-relaxed">${tasksHtml}</div>
                </div>`;
            }).join('');

            return `<article id="week-${w.week}" class="bg-white dark:bg-slate-800 rounded-3xl p-6 shadow-sm border border-slate-100 dark:border-slate-700 relative transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-indigo-200 dark:hover:border-indigo-700">
                <div class="absolute -top-3 left-6 bg-indigo-600 text-white text-xs font-bold px-4 py-1.5 rounded-full shadow-md tracking-widest uppercase">Minggu ${w.week}</div>
                <div class="space-y-6 mt-4">${daysHtml}</div>
            </article>`;
        }).join('');
    }

    function renderFridaySchedule() {
        const el = document.getElementById('fridayGrid');
        el.innerHTML = FRIDAY_SCHEDULE.map(w => {
            const tasksHtml = w.tasks.map(t => {
                // Perbaikan: Semua tugas jumat juga diseragamkan dengan badge
                const badge = `<span class="${getBadgeClass(t.type)} text-[9px] py-0.5 px-1.5 text-right ml-2 whitespace-normal">${t.task}</span>`;
                return `<div class="flex justify-between items-start transition-all duration-300 py-1 border-b border-slate-50 dark:border-slate-700/50 last:border-0" data-member="${t.name}">
                            <span class="font-semibold text-slate-900 dark:text-white shrink-0 mt-0.5">${t.name}</span>
                            ${badge}
                        </div>`;
            }).join('');
            return `<article id="friday-m${w.week}" data-friday-week="${w.week}" class="friday-card bg-white dark:bg-slate-800 rounded-2xl p-5 shadow-sm border border-slate-200 dark:border-slate-700 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg relative">
                <h3 class="text-indigo-600 dark:text-indigo-400 font-bold mb-3 border-b border-indigo-100 dark:border-indigo-800 pb-2 flex items-center justify-between">Jum'at <span class="bg-indigo-600 text-white text-[11px] px-2.5 py-0.5 rounded-full shadow-sm">M${w.week}</span></h3>
                <div class="text-xs text-slate-600 dark:text-slate-300">${tasksHtml}</div>
            </article>`;
        }).join('');
    }

    function renderMemberFilter() {
        const el = document.getElementById('memberFilter');
        MEMBERS.forEach(m => {
            const opt = document.createElement('option'); opt.value = m; opt.textContent = m;
            el.appendChild(opt);
        });
    }

    // =====================================================
    // LOGIKA FILTER & HIGHLIGHT UI
    // =====================================================
    function highlightActiveWeek() {
        const { daily: activeDaily, friday: activeFriday, diffDays } = getActiveWeeks();
        
        const finalDaily = MANUAL_DAILY_WEEK ?? activeDaily;
        const finalFriday = MANUAL_FRIDAY_WEEK ?? activeFriday;
        
        activeFridayGlobal = finalFriday;

        document.querySelectorAll('.week-active').forEach(e => e.classList.remove('week-active'));

        const weekEl = document.getElementById('week-' + finalDaily);
        if (weekEl) weekEl.classList.add('week-active');

        const fridayEl = document.getElementById('friday-m' + finalFriday);
        if (fridayEl) fridayEl.classList.add('week-active');

        const badge = document.getElementById('cycleBadge');
        if (badge) badge.innerHTML = `<i class="ph ph-clock text-lg text-indigo-500" aria-hidden="true"></i> Harian M${finalDaily} • Jumat M${finalFriday}`;

        const todayNames = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
        const currentDayIndex = new Date().getDay();
        const todayEl = document.getElementById('todayText');
        if (todayEl) {
            todayEl.textContent = `${todayNames[currentDayIndex]}, M${finalDaily}`;
        }
        
        renderBilasFriday();
        updateFridayVisibility();

        // Fitur Auto Scroll ke elemen "Hari Ini"
        setTimeout(() => {
            const actualDailyDayIndex = mod(diffDays, 14);
            const todayBlock = document.getElementById(`day-block-${actualDailyDayIndex}`);
            // Scroll ke jadwal harian, atau scroll ke jadwal jumat jika hari ini adalah jumat
            if(currentDayIndex >= 1 && currentDayIndex <= 4 && todayBlock){
                todayBlock.scrollIntoView({ behavior: 'smooth', block: 'center' });
            } else if (currentDayIndex === 5 && fridayEl && !showAllFriday) {
                fridayEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }, 500);
    }

    function toggleMemberFilter(name) {
        const select = document.getElementById('memberFilter');
        if (select.value === name) {
            select.value = ""; 
            filterByMember("");
        } else {
            select.value = name;
            filterByMember(name);
        }
    }

    function filterByMember(name) {
        document.querySelectorAll('.member-highlight').forEach(el => el.classList.remove('member-highlight'));
        document.querySelectorAll('.member-btn').forEach(btn => {
            btn.classList.remove('bg-indigo-100', 'border-indigo-400', 'text-indigo-800', 'dark:bg-indigo-900/50', 'dark:border-indigo-500', 'dark:text-indigo-200');
        });

        const resetBtn = document.getElementById('resetFilterBtn');

        if (!name) {
            document.body.classList.remove('filter-active');
            if(resetBtn) resetBtn.classList.add('hidden');
            return;
        }

        document.body.classList.add('filter-active');
        if(resetBtn) resetBtn.classList.remove('hidden');

        document.querySelectorAll(`[data-member="${name}"]`).forEach(el => {
            el.classList.add('member-highlight');
        });
        
        const activeBtn = document.getElementById(`btn-member-${name}`);
        if (activeBtn) {
            activeBtn.classList.add('bg-indigo-100', 'border-indigo-400', 'text-indigo-800', 'dark:bg-indigo-900/50', 'dark:border-indigo-500', 'dark:text-indigo-200');
        }
    }

    function toggleFridayVisibility() {
        showAllFriday = !showAllFriday;
        const btn = document.getElementById('toggleFridayBtn');
        btn.innerHTML = showAllFriday ? `<i class="ph-bold ph-eye-slash"></i> Sembunyikan` : `<i class="ph-bold ph-eye"></i> Tampilkan Semua`;
        updateFridayVisibility();
    }

    function updateFridayVisibility() {
        document.querySelectorAll('.friday-card').forEach(card => {
            const week = parseInt(card.dataset.fridayWeek);
            if (!showAllFriday && week !== activeFridayGlobal) {
                card.classList.add('friday-hidden');
            } else {
                card.classList.remove('friday-hidden');
            }
        });
    }

    function updateFooterDate() {
        const timeEl = document.getElementById('lastUpdated');
        if (timeEl) {
            const now = new Date();
            const options = { year: 'numeric', month: 'long', day: 'numeric' };
            timeEl.textContent = now.toLocaleDateString('id-ID', options);
            timeEl.setAttribute('datetime', now.toISOString().split('T')[0]);
        }
    }

    // =====================================================
    // MODAL & DARK MODE 
    // =====================================================
    const modal = document.getElementById('guideModal');
    const modalContent = document.getElementById('modalContent');
    const modalOverlay = modal.querySelector('.modal-overlay');

    function openModal() {
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(() => {
            modalOverlay.classList.add('active');
            modalContent.classList.add('active');
        });
    }

    function closeModal() {
        modalOverlay.classList.remove('active');
        modalContent.classList.remove('active');
        document.body.style.overflow = '';
        setTimeout(() => modal.classList.add('hidden'), 300);
    }

    function toggleDarkMode() {
        document.documentElement.classList.toggle('dark');
        localStorage.setItem('darkMode', document.documentElement.classList.contains('dark'));
    }

    (function initDarkMode() {
        const saved = localStorage.getItem('darkMode');
        if (saved === 'true' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        }
    })();

    // =====================================================
    // INIT
    // =====================================================
    document.addEventListener('DOMContentLoaded', () => {
        renderMembers();
        renderOmpreng();
        renderFridayRotation();
        renderBilas();
        renderBilasFriday();
        renderDailySchedule();
        renderFridaySchedule();
        renderMemberFilter();
        
        highlightActiveWeek();
        updateFooterDate();

        document.getElementById('memberFilter').addEventListener('change', (e) => filterByMember(e.target.value));
    });
    </script>
</body>
</html>
