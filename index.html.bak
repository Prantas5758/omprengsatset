<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Jadwal piket dan pembagian tugas tim kebersihan harian dengan siklus rotasi 8 minggu. Termasuk jadwal bilas, ompreng, bilas Jum'at, dan tugas khusus Jumat.">
    <meta name="keywords" content="jadwal piket, ompreng, rotasi tugas, jadwal bilas, bilas jumat, kebersihan">
    <meta name="author" content="Tim Manajemen SatsetDasdes">
    <meta name="theme-color" content="#4f46e5">

    <!-- Open Graph -->
    <meta property="og:title" content="Jadwal Piket & Ompreng - SatsetDasdes Edition">
    <meta property="og:description" content="Jadwal piket dan pembagian tugas tim kebersihan harian dengan siklus rotasi 8 minggu.">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="id_ID">

    <!-- PWA Ready -->
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Jadwal Piket">

    <title>Jadwal Piket & Ompreng - SatsetDasdes Edition</title>

    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.tailwindcss.com">
    <link rel="preconnect" href="https://unpkg.com">

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        task: {
                            gestrep: '#10b981',
                            westafel: '#f43f5e',
                            ompreng: '#6366f1',
                            lantai: '#f59e0b',
                            selokan: '#06b6d4',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --primary: #4f46e5;
            --primary-light: #eef2ff;
        }
        .dark { --primary: #818cf8; --primary-light: #1e1b4b; }

        body { font-family: 'Inter', sans-serif; }
        html { scroll-behavior: smooth; scroll-padding-top: 100px; } /* Ditambah untuk offset auto-scroll */

        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
        .dark ::-webkit-scrollbar-thumb { background: #475569; }

        /* Sticky Nav */
        .sticky-nav {
            position: sticky;
            top: 0;
            z-index: 40;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        /* Modal Animation */
        .modal-overlay { opacity: 0; transition: opacity 300ms ease; }
        .modal-overlay.active { opacity: 1; }
        .modal-content { opacity: 0; transform: scale(0.95) translateY(10px); transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1); }
        .modal-content.active { opacity: 1; transform: scale(1) translateY(0); }

        /* Active Week */
        .week-active {
            border-color: var(--primary) !important;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15), 0 8px 30px rgb(0,0,0,0.04) !important;
        }
        .week-active::before {
            content: '📍 Minggu Ini';
            position: absolute;
            top: -12px;
            right: 16px;
            background: var(--primary);
            color: white;
            font-size: 10px;
            font-weight: 700;
            padding: 2px 10px;
            border-radius: 9999px;
            letter-spacing: 0.05em;
            z-index: 5;
        }
        #fridayGrid article { overflow: visible; }

        /* Today Highlight Akurat */
        .today-highlight {
            background: linear-gradient(135deg, rgba(79,70,229,0.05), rgba(99,102,241,0.1));
            border-left: 4px solid var(--primary);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }
        .dark .today-highlight {
            background: linear-gradient(135deg, rgba(79,70,229,0.15), rgba(99,102,241,0.2));
        }

        /* FILTER ANGGOTA EFEK */
        [data-member] {
            transition: opacity 0.3s ease, filter 0.3s ease, transform 0.2s ease;
        }

        /* Saat filter aktif, redupkan yang tidak disorot */
        body.filter-active [data-member] {
            opacity: 0.3; /* Sedikit dinaikkan agar tidak terlalu hilang */
            filter: grayscale(100%);
        }

        /* Highlight visual jelas untuk anggota yang disorot */
        body.filter-active [data-member].member-highlight {
            opacity: 1;
            filter: none;
            background-color: #fef08a !important;
            border-radius: 6px;
            padding: 6px 8px; /* Padding sedikit dibesarkan */
            margin: -6px -8px;
            box-shadow: 0 2px 10px rgba(234, 179, 8, 0.3);
            z-index: 10;
            position: relative;
            transform: scale(1.02); /* Efek pop-out sedikit */
        }
        
        .dark body.filter-active [data-member].member-highlight {
            background-color: rgba(234, 179, 8, 0.15) !important;
            box-shadow: 0 2px 10px rgba(234, 179, 8, 0.2);
            border: 1px solid rgba(234, 179, 8, 0.4);
        }

        /* Task color badges */
        .badge-base { padding: 0.125rem 0.5rem; border-radius: 0.25rem; font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; display: inline-block; line-height: 1.2; word-break: break-word; }
        .badge-gestrep { background: #d1fae5; color: #065f46; border: 1px solid #a7f3d0; }
        .badge-westafel { background: #ffe4e6; color: #9f1239; border: 1px solid #fecdd3; }
        .badge-ompreng { background: #e0e7ff; color: #3730a3; border: 1px solid #c7d2fe; }
        .badge-lantai { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
        .badge-selokan { background: #cffafe; color: #155e75; border: 1px solid #a5f3fc; }
        .badge-tutup { background: #fce7f3; color: #9d174d; border: 1px solid #fbcfe8; }

        .dark .badge-gestrep { background: rgba(16,185,129,0.2); color: #a7f3d0; border-color: rgba(16,185,129,0.5); }
        .dark .badge-westafel { background: rgba(244,63,94,0.2); color: #fecdd3; border-color: rgba(244,63,94,0.5); }
        .dark .badge-ompreng { background: rgba(99,102,241,0.2); color: #c7d2fe; border-color: rgba(99,102,241,0.5); }
        .dark .badge-lantai { background: rgba(245,158,11,0.2); color: #fde68a; border-color: rgba(245,158,11,0.5); }
        .dark .badge-selokan { background: rgba(6,182,212,0.2); color: #a5f3fc; border-color: rgba(6,182,212,0.5); }
        .dark .badge-tutup { background: rgba(236,72,153,0.2); color: #fbcfe8; border-color: rgba(236,72,153,0.5); }

        /* Sembunyikan minggu jumat selain minggu aktif */
        .friday-hidden { display: none; }

        /* Focus */
        :focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; border-radius: 4px; }

        /* Print Settings Khusus */
        @media print {
            body { background: white !important; padding: 0 !important; }
            .no-print, .sticky-nav { display: none !important; }
            .print-break { page-break-before: always; }
            article, section { box-shadow: none !important; break-inside: avoid; }
            .week-active::before { display: none; }
            .member-highlight { background: none !important; box-shadow: none !important; transform: none !important; }
            .friday-hidden { display: block !important; }
            /* Memaksa background color ikut tercetak (Chrome/Edge/Safari) */
            * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
        }

        * { transition-property: background-color, border-color; transition-duration: 200ms; transition-timing-function: ease; }
        
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-in { animation: fadeInUp 0.5s ease forwards; }
    </style>
</head>
<body class="p-4 md:p-8 lg:p-12 min-h-screen flex justify-center text-slate-800 dark:text-slate-200 selection:bg-indigo-100 dark:selection:bg-indigo-900 selection:text-indigo-900 dark:selection:text-indigo-100 relative bg-slate-100 dark:bg-slate-900">

    <div class="max-w-[1400px] w-full relative z-10">
        <!-- ===== STICKY NAVIGATION ===== -->
        <nav class="sticky-nav no-print bg-white/80 dark:bg-slate-900/80 border-b border-slate-200 dark:border-slate-700 -mx-4 md:-mx-8 lg:-mx-12 px-4 md:px-8 lg:px-12 py-3 mb-8" aria-label="Navigasi utama">
            <div class="flex items-center justify-between gap-4 flex-wrap">
                <div class="flex items-center gap-2">
                    <div class="bg-indigo-600 p-1.5 rounded-lg text-white">
                        <i class="ph-bold ph-calendar-check text-lg" aria-hidden="true"></i>
                    </div>
                    <span class="font-bold text-sm text-slate-900 dark:text-white hidden sm:inline">SatsetDasdes</span>
                </div>

                <div class="flex items-center gap-1 text-xs font-semibold" role="tablist">
                    <a href="#daily-schedule" class="px-3 py-1.5 rounded-full text-slate-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors">Harian</a>
                    <a href="#friday-schedule" class="px-3 py-1.5 rounded-full text-slate-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors">Jumat</a>
                    <a href="#bilas-section" class="px-3 py-1.5 rounded-full text-slate-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors">Bilas</a>
                    <a href="#bilas-friday-section" class="px-3 py-1.5 rounded-full text-slate-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-indigo-900/30 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors">Bilas Jum'at</a>
                </div>

                <div class="flex items-center gap-2">
                    <div id="todayIndicator" class="text-xs font-bold bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 px-3 py-1.5 rounded-full border border-indigo-200 dark:border-indigo-800 hidden sm:flex items-center gap-1.5">
                        <i class="ph-bold ph-calendar-dot text-sm" aria-hidden="true"></i>
                        <span id="todayText">...</span>
                    </div>
                    
                    <!-- Container Filter Select + Reset Button -->
                    <div class="relative flex items-center">
                        <select id="memberFilter" aria-label="Filter berdasarkan anggota" class="no-print text-xs font-semibold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-full px-3 py-1.5 pr-8 text-slate-700 dark:text-slate-300 cursor-pointer focus:ring-2 focus:ring-indigo-500 appearance-none">
                            <option value="">👤 Semua Anggota</option>
                        </select>
                        <i class="ph-bold ph-caret-down absolute right-3 text-slate-400 pointer-events-none text-xs"></i>
                        <!-- Reset Filter Button (Hidden default) -->
                        <button id="resetFilterBtn" onclick="toggleMemberFilter('')" class="hidden absolute -right-2 -top-2 bg-red-100 text-red-600 hover:bg-red-200 rounded-full p-1 shadow-sm transition-all dark:bg-red-900/50 dark:text-red-300" title="Reset Filter">
                            <i class="ph-bold ph-x text-[10px]"></i>
                        </button>
                    </div>

                    <button id="darkModeToggle" onclick="toggleDarkMode()" aria-label="Toggle mode gelap" class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors ml-1">
                        <i class="ph-bold ph-moon text-lg dark:hidden" aria-hidden="true"></i>
                        <i class="ph-bold ph-sun text-lg hidden dark:inline" aria-hidden="true"></i>
                    </button>
                    <button onclick="window.print()" aria-label="Cetak jadwal" class="hidden sm:block p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                        <i class="ph-bold ph-printer text-lg" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </nav>

        <!-- ===== HEADER ===== -->
        <header class="mb-10 flex flex-col xl:flex-row xl:items-end justify-between gap-4 border-b border-slate-200 dark:border-slate-700 pb-6 animate-in">
            <div>
                <div class="flex items-center gap-3 mb-2">
                    <div class="bg-indigo-600 p-2 rounded-xl text-white shadow-lg shadow-indigo-200 dark:shadow-indigo-900/30">
                        <i class="ph-bold ph-calendar-check text-2xl" aria-hidden="true"></i>
                    </div>
                    <span class="text-sm font-bold tracking-widest uppercase text-indigo-600 dark:text-indigo-400">Manajemen Tim</span>
                </div>
                <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
                    Jadwal Piket & Ompreng
                </h1>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <div id="cycleBadge" class="text-slate-500 dark:text-slate-400 text-sm font-medium flex items-center gap-2 bg-white dark:bg-slate-800 px-4 py-2.5 rounded-full shadow-sm border border-slate-200 dark:border-slate-700">
                    <i class="ph ph-clock text-lg text-indigo-500" aria-hidden="true"></i> Siklus 8 Minggu
                </div>
                <button onclick="openModal()" aria-label="Buka panduan tugas" class="no-print text-sm font-bold flex items-center gap-2 bg-indigo-50 dark:bg-indigo-900/30 hover:bg-indigo-100 dark:hover:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 px-5 py-2.5 rounded-full shadow-sm border border-indigo-200 dark:border-indigo-800 transition-colors group">
                    <i class="ph-bold ph-info text-lg group-hover:scale-110 transition-transform" aria-hidden="true"></i> Panduan
                </button>
            </div>
        </header>

        <!-- ===== MAIN LAYOUT ===== -->
        <main class="flex flex-col-reverse xl:grid xl:grid-cols-12 gap-8">
            <!-- ===== SIDEBAR ===== -->
            <aside class="xl:col-span-3 space-y-6 xl:sticky xl:top-20 h-fit">
                <!-- Filter Anggota -->
                <section class="bg-white dark:bg-slate-800 rounded-3xl p-6 shadow-sm border border-slate-100 dark:border-slate-700 transition-all duration-300 hover:shadow-lg hover:border-indigo-100 dark:hover:border-indigo-800">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-4 flex items-center gap-2">
                        <i class="ph-bold ph-users text-indigo-400" aria-hidden="true"></i> Highlight Cepat
                    </h2>
                    <div class="flex flex-wrap gap-2" role="list" id="memberList"></div>
                    <p class="text-[10px] text-slate-400 mt-3 italic">*Klik nama untuk menyorot jadwal individu.</p>
                </section>

                <!-- Ompreng -->
                <section class="bg-white dark:bg-slate-800 rounded-3xl p-6 shadow-sm border border-slate-100 dark:border-slate-700 relative overflow-hidden">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-5 flex items-center gap-2 relative z-10">
                        <i class="ph-bold ph-arrows-out-line-horizontal text-indigo-400" aria-hidden="true"></i> Memindahkan Ompreng
                    </h2>
                    <div class="space-y-4 relative z-10" id="omprengSchedule"></div>
                </section>

                <!-- Rotasi Jumat -->
                <section class="bg-slate-900 dark:bg-slate-950 rounded-3xl p-6 shadow-xl border border-slate-800 dark:border-slate-700 text-slate-300">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-indigo-400 mb-5 flex items-center gap-2">
                        <i class="ph-bold ph-arrows-clockwise text-indigo-300" aria-hidden="true"></i> Rotasi Jum'at
                    </h2>
                    <div class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm" id="fridayRotation"></div>
                </section>

                <!-- Jadwal Bilas -->
                <section id="bilas-section" class="bg-white dark:bg-slate-800 rounded-3xl p-6 shadow-sm border border-slate-100 dark:border-slate-700">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-5 flex items-center gap-2">
                        <i class="ph-bold ph-drop text-blue-400" aria-hidden="true"></i> Jadwal Bilas
                    </h2>
                    <div class="space-y-4" id="bilasSchedule"></div>
                </section>

                <!-- Jadwal Bilas Jum'at -->
                <section id="bilas-friday-section" class="bg-white dark:bg-slate-800 rounded-3xl p-6 shadow-sm border border-slate-100 dark:border-slate-700 scroll-mt-24">
                    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-5 flex items-center gap-2">
                        <i class="ph-bold ph-drop-half-bottom text-violet-400" aria-hidden="true"></i> Bilas Jum'at
                    </h2>
                    <div class="space-y-2" id="bilasFridaySchedule"></div>
                    <p class="text-[10px] text-slate-400 mt-3 italic">*Zaidan bertugas setiap minggu, bergantian dengan partner rotasi.</p>
                </section>
            </aside>

            <!-- ===== KONTEN UTAMA ===== -->
            <div class="xl:col-span-9 space-y-8">
                <!-- Jadwal Harian -->
                <section id="daily-schedule" class="scroll-mt-24">
                    <h2 class="text-xl font-bold text-slate-800 dark:text-white mb-6 flex items-center gap-2">
                        Jadwal Piket Harian <span class="text-slate-500 dark:text-slate-400 font-normal text-sm ml-2 bg-white dark:bg-slate-800 px-2 py-1 rounded shadow-sm border border-slate-200 dark:border-slate-700">Senin - Kamis</span>
                    </h2>
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6" id="dailyGrid"></div>
                </section>

                <!-- Jadwal Jumat -->
                <section id="friday-schedule" class="mt-10 print-break scroll-mt-24">
                    <div class="flex items-center justify-between mb-6 flex-wrap gap-4">
                        <h2 class="text-xl font-bold text-slate-800 dark:text-white flex items-center gap-2">
                            Jadwal Piket Khusus Jum'at
                        </h2>
                        <button onclick="toggleFridayVisibility()" id="toggleFridayBtn" class="no-print text-sm bg-indigo-50 hover:bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800 px-4 py-2 rounded-full font-semibold transition-colors flex items-center gap-2">
                            <i class="ph-bold ph-eye"></i> Tampilkan Semua
                        </button>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4" id="fridayGrid"></div>
                </section>
            </div>
        </main>

        <!-- ===== FOOTER ===== -->
        <footer class="mt-12 pt-6 border-t border-slate-200 dark:border-slate-700 text-center text-sm text-slate-500 dark:text-slate-400 pb-8">
            <p>Jadwal Piket & Ompreng • Siklus 8 Minggu • Terakhir diperbarui: <time id="lastUpdated" datetime="">Memuat...</time></p>
        </footer>
    </div>

    <!-- ===== MODAL PANDUAN ===== -->
    <div id="guideModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 hidden">
        <div class="modal-overlay absolute inset-0 bg-slate-900/40 dark:bg-black/60 backdrop-blur-sm" onclick="closeModal()"></div>
        <div id="modalContent" class="modal-content bg-white dark:bg-slate-800 rounded-3xl w-full max-w-2xl shadow-2xl relative z-10 overflow-hidden flex flex-col max-h-[90vh]">
            <div class="bg-indigo-600 text-white p-5 sm:p-6 flex justify-between items-center">
                <h2 class="text-xl font-bold flex items-center gap-2"><i class="ph-fill ph-info text-2xl text-indigo-200" aria-hidden="true"></i> Panduan & Keterangan Tugas</h2>
                <button onclick="closeModal()" class="text-white hover:bg-indigo-500 p-1.5 rounded-full transition-colors">
                    <i class="ph-bold ph-x text-xl" aria-hidden="true"></i>
                </button>
            </div>
            <div class="p-5 sm:p-6 overflow-y-auto space-y-6 text-slate-700 dark:text-slate-300">
                <div>
                    <h3 class="font-bold text-slate-900 dark:text-white border-b border-slate-200 dark:border-slate-600 pb-2 mb-3">1. Siklus Minggu</h3>
                    <p class="text-sm">Jadwal berputar berdasarkan: Senin - Kamis (2 putaran) & Jum'at (8 putaran penuh).</p>
                </div>
                <div>
                    <h3 class="font-bold text-slate-900 dark:text-white border-b border-slate-200 dark:border-slate-600 pb-2 mb-3">2. Bilas Jum'at</h3>
                    <p class="text-sm">Zaidan bertugas bilas setiap Jum'at, bergantian tugas Ompreng/Tutup dengan partner rotasi (Rizal, Adit, Bowo, Zakaria, Fajar R, Fajar M, Aziz, Agus).</p>
                </div>
            </div>
            <div class="bg-slate-50 dark:bg-slate-700/50 p-4 sm:p-6 text-right border-t border-slate-200 dark:border-slate-600">
                <button onclick="closeModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-xl shadow-md transition-colors">Tutup</button>
            </div>
        </div>
    </div>

    <!-- ===== JAVASCRIPT ===== -->
    <script>
    // =====================================================
    // DATA SCHEDULE
    // =====================================================
    const MEMBERS = ['Adit', 'Agus', 'Aziz', 'Fajar M', 'Fajar R', 'Bowo', 'Rizal', 'Zaidan', 'Zakaria'];
    const CYCLE_START_DATE = '2026-08-17'; // Senin
    
    // Override Manual
    const MANUAL_DAILY_WEEK = null;
    const MANUAL_FRIDAY_WEEK = null;
    
    let activeFridayGlobal = 1; 
    let showAllFriday = false;

    const OMPRENG_SCHEDULE = {
        'Senin': 'Rizal & Adit', 'Selasa': 'Bowo & Zakaria', 'Rabu': 'Fajar R & Fajar M', 'Kamis': 'Agus & Aziz'
    };
    const FRIDAY_ROTATION = ['Rizal', 'Adit', 'Bowo', 'Zakaria', 'Fajar R', 'Fajar M', 'Aziz', 'Agus'];

    const BILAS_SCHEDULE = [
        { week: 1, days: [
            { day: 'SEN', p1: { name: 'Fajar M', task: 'Tutup' }, p2: { name: 'Fajar R', task: 'Ompreng' } },
            { day: 'SEL', p1: { name: 'Agus', task: 'Ompreng' }, p2: { name: 'Aziz', task: 'Tutup' } },
            { day: 'RAB', p1: { name: 'Adit', task: 'Ompreng' }, p2: { name: 'Rizal', task: 'Tutup' } },
            { day: 'KAM', p1: { name: 'Zakaria', task: 'Tutup' }, p2: { name: 'Bowo', task: 'Ompreng' } },
        ]},
        { week: 2, days: [
